# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=7017550401
DB_NAME=knowledge_management

# AI provider for summaries + chatbot: "claude" or "gemini"
AI_PROVIDER=gemini

# Claude API (get a key from https://console.anthropic.com) — used when AI_PROVIDER=claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5

# Gemini API (free tier — get a key from https://aistudio.google.com/apikey) — used when AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Upload limits
MAX_FILE_SIZE_MB=25
